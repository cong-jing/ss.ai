{
    "compilerOptions": {
        "target": "ES2022",
        "module": "node18",
        "moduleResolution": "node16",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "outDir": "dist",
        "rootDir": "."
    },
    "include": [
        "src/**/*.ts",
        "shared/contracts/**/*.ts"
    ],
    "exclude": [
        "dist",
        "node_modules"
    ]
}
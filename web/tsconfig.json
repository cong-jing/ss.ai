{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "jsx": "preserve",
        "useDefineForClassFields": true,
        "types": [
            "vite/client"
        ],
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2020"
        ]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.vue",
        "../shared/contracts/**/*.ts"
    ]
}
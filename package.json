{
    "name": "ss-ai",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.3.0",
    "description": "Node.js + TypeScript scaffold with reusable agent core and runtime launchers",
    "type": "module",
    "scripts": {
        "setup": "npm install -g corepack@latest && corepack enable pnpm && corepack prepare pnpm@11.3.0 --activate && pnpm install",
        "preinstall": "node scripts/check-package-manager.mjs",
        "build": "pnpm -r build",
        "build:server": "pnpm --filter @ss-ai/server... build",
        "build:web": "pnpm --filter @ss-ai/web... build",
        "deploy:server": "pnpm --filter @ss-ai/server --prod deploy ./deploy/server",
        "clean": "node scripts/clean.mjs",
        "dev": "pnpm run dev:all",
        "dev:all": "concurrently --names \"server,web\" \"pnpm run dev:server\" \"pnpm run dev:web\"",
        "dev:server": "pnpm --filter @ss-ai/server dev",
        "dev:web": "pnpm --filter @ss-ai/web dev",
        "dev:qq-bot": "pnpm --filter qq-bot dev -- --config ./qq-bot.env",
        "prompt:debug": "pnpm --filter @ss-ai/prompt-debug-cli dev --",
        "start": "pnpm run start:server",
        "start:server": "pnpm --filter @ss-ai/server start",
        "test": "pnpm -r --if-present test"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.2.1",
        "concurrently": "^9.2.1",
        "esbuild": "^0.24.2",
        "typescript": "^5.6.3",
        "vite": "^5.4.11",
        "vue-tsc": "^2.1.10"
    }
}
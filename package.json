{
    "name": "ss-ai",
    "version": "0.1.0",
    "private": true,
    "description": "Node.js + TypeScript scaffold with reusable agent core and runtime launchers",
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build:server && npm run build:web",
        "build:server": "tsc -p apps/server/tsconfig.json",
        "build:web": "npm run build --workspace=apps/web",
        "dev": "npm run dev:all",
        "dev:all": "concurrently --names \"server,web\" \"npm run dev:server\" \"npm run dev:web\"",
        "dev:server": "tsx apps/server/src/index.ts",
        "dev:web": "npm run dev --workspace=apps/web",
        "dev:qq-bot": "chcp 65001 > nul && tsx apps/qq-bot/src/index.ts --config ./qq-bot.env",
        "prompt:debug": "npm run dev --workspace=apps/prompt-debug-cli --",
        "start": "npm run start:server",
        "start:server": "node apps/server/dist/index.js",
        "test": "npm run test --workspaces --if-present"
    },
    "dependencies": {
        "@mistralai/mistralai": "^2.2.1",
        "ajv": "^8.20.0",
        "express": "^4.19.2",
        "handlebars": "^4.7.9",
        "vue": "^3.5.13",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.7.4",
        "@vitejs/plugin-vue": "^5.2.1",
        "concurrently": "^9.2.1",
        "esbuild": "^0.24.2",
        "tsx": "^4.19.1",
        "typescript": "^5.6.3",
        "vite": "^5.4.11",
        "vue-tsc": "^2.1.10"
    }
}
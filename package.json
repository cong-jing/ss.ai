{
    "name": "ss-ai",
    "version": "0.1.0",
    "private": true,
    "description": "Node.js + TypeScript scaffold with reusable agent core and runtime launchers",
    "scripts": {
        "build": "npm run build:server && npm run build:web",
        "build:server": "tsc -p tsconfig.json",
        "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
        "build:web": "npm run typecheck:web && esbuild web/src/main.ts --bundle --format=esm --sourcemap --outfile=web/dist/app.js",
        "dev:web": "esbuild web/src/main.ts --bundle --format=esm --sourcemap --outfile=web/dist/app.js --watch",
        "dev:serve": "tsx src/index.ts",
        "prod:serve": "node dist/src/index.js"
    },
    "dependencies": {
        "@mistralai/mistralai": "^2.2.1",
        "ajv": "^8.20.0",
        "express": "^4.19.2",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.7.4",
        "esbuild": "^0.24.2",
        "tsx": "^4.19.1",
        "typescript": "^5.6.3"
    }
}
{
    "name": "ss-ai",
    "version": "0.1.0",
    "private": true,
    "description": "Node.js + TypeScript scaffold with reusable agent core and runtime launchers",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev:serve": "tsx src/index.ts serve",
        "dev:cli": "tsx src/index.ts cli",
        "dev:chat": "tsx src/index.ts cli chat",
        "prod:serve": "node dist/src/index.js serve",
        "prod:cli": "node dist/src/index.js cli"
    },
    "dependencies": {
        "commander": "^12.1.0",
        "express": "^4.19.2"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.7.4",
        "tsx": "^4.19.1",
        "typescript": "^5.6.3"
    }
}
{
    "name": "@ss-ai/persona-flow",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
        "clean": "node scripts/clean.mjs",
        "test": "tsx --test test/.run.ts",
        "typecheck": "tsc --noEmit"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "dependencies": {
        "@ss-ai/contracts": "workspace:*",
        "handlebars": "^4.7.9",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/node": "^25.6.2",
        "tsx": "*",
        "typescript": "*"
    }
}
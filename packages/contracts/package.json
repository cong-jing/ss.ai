{
    "name": "@ss-ai/contracts",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./src/index.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json"
    },
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "types": "./src/index.ts",
            "import": "./dist/index.js"
        },
        "./turnEvents.schema": {
            "source": "./src/turnEvents.schema.ts",
            "types": "./src/turnEvents.schema.ts",
            "import": "./dist/turnEvents.schema.js"
        },
        "./memoryCandidates.schema": {
            "source": "./src/memoryCandidates.schema.ts",
            "types": "./src/memoryCandidates.schema.ts",
            "import": "./dist/memoryCandidates.schema.js"
        },
        "./apis/userPreference": {
            "source": "./src/apis/userPreference.api.ts",
            "types": "./src/apis/userPreference.api.ts",
            "import": "./dist/apis/userPreference.api.js"
        },
        "./apis/userProfile": {
            "source": "./src/apis/userProfile.api.ts",
            "types": "./src/apis/userProfile.api.ts",
            "import": "./dist/apis/userProfile.api.js"
        },
        "./apis/auth": {
            "source": "./src/apis/auth.api.ts",
            "types": "./src/apis/auth.api.ts",
            "import": "./dist/apis/auth.api.js"
        }
    },
    "dependencies": {
        "zod": "^4.3.6"
    }
}
{
    "name": "@ss-ai/server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "APP_HOME=../.. tsx --conditions=source src/index.ts",
        "build": "tsc -p tsconfig.build.json && node scripts/copy-runtime-assets.mjs",
        "start": "APP_HOME=../.. node dist/index.js",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test test/.run.ts"
    },
    "dependencies": {
        "@ss-ai/contracts": "workspace:*",
        "@ss-ai/persona-flow": "workspace:*",
        "@ss-ai/persona-flow-logger": "workspace:*",
        "@ss-ai/persona-flow-model-client": "workspace:*",
        "@ss-ai/persona-flow-sqlite": "workspace:*",
        "ajv": "^8.20.0",
        "express": "^4.19.2"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/supertest": "^7.2.0",
        "supertest": "^7.2.2",
        "tsx": "^4.20.6"
    }
}

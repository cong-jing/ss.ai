# Character name to bind qq-bot runtime (exact match)
CHARACTER_NAME=

# NapCat access token (optional)
NAPCAT_ACCESS_TOKEN=

# NapCat / OneBot websocket URL
NAPCAT_WS_URL=ws://127.0.0.1:3001

# Chat server base URL
CHAT_SERVER_URL=http://127.0.0.1:8999

# Runtime output directory for qq-bot mapping files
OUTPUT_DIR=./.runtime/user-data-dev/qq-bot
# Files written under OUTPUT_DIR:
# - conversation-map.json
#   (contains conversation bindings + actor bindings)

# Log file path (simple single log, no levels)
LOG_FILE_PATH=./.runtime/logs/qq-bot.log

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Dry run mode: log server API calls and params only, never actually call server
QQ_BOT_DRY_RUN=false
